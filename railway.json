{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run bygg"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"node web/scripts/migrer.mjs && exec node node_modules/next/dist/bin/next start web\"",
    "healthcheckPath": "/api/offentlig/arrangementer",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
