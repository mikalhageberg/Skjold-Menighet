{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "utvikling": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "utvikling",
      "env": {
        "EXPO_PUBLIC_API_BASE": "http://localhost:3000"
      }
    },
    "test": {
      "distribution": "internal",
      "channel": "test",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://skjold-menighet.vercel.app"
      }
    },
    "produksjon": {
      "autoIncrement": true,
      "channel": "produksjon",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://skjold-menighet.vercel.app"
      }
    }
  },
  "submit": {
    "produksjon": {}
  }
}
