# ── Database ──────────────────────────────────────────────────────────
# Stien til SQLite-fila. På Railway: stien på volumet, f.eks. /data/skjold.db.
# Lokalt: en mappe i prosjektet, f.eks. ./data/skjold.db (lages automatisk).
# Uten denne kjører appen i demomodus.
DATABASE_PATH=

# ── Innlogging til admin ──────────────────────────────────────────────
# Lag en med:  openssl rand -base64 32
AUTH_SECRET=

# ── Brevo ─────────────────────────────────────────────────────────────
# Nøkkel fra brevo.com → SMTP & API → API Keys.
# Avsenderadressen må være verifisert under Senders & IP, ellers avvises alt.
BREVO_API_KEY=
BREVO_SENDER_NAME=Skjold menighet
BREVO_SENDER_EMAIL=

# ── Påminnelser og oppsummeringer ─────────────────────────────────────
# Beskytter cron-ruta. Lag en med:  openssl rand -base64 32
CRON_SECRET=

# Hvem som skal ha beskjed når noen ber om Android-appen. Timesjobben
# sender én samlet e-post, og ingenting når det ikke er kommet noen.
# Står den tom, går det ingen beskjed — se /android for lista.
VARSEL_EPOST=

# Adressen til nettsida, brukt til å lage lenker i e-post. Railway setter
# RAILWAY_PUBLIC_DOMAIN selv, så lenkene virker uten denne — sett den når
# dere har et eget domene, f.eks. https://skjold.online.
NETTSTED_URL=

# ── Lenker til appen i butikkene ──────────────────────────────────────
# Vises på /app. Står de tomme, faller knappen bort i stedet for å lenke
# til ingenting.
# App Store-lenken er offentlig og går rett i knappen.
APP_STORE_URL=
# Play-lenken vises aldri på nettsiden — appen ligger i lukket test, så
# den sendes bare på e-post til dem som er lagt inn i testgruppen.
# Se /android for hvordan runden gjøres.
GOOGLE_PLAY_URL=
